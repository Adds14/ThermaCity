# ── ThermaCity — Production Environment Variables ───────────
# Copy this file to .env.production on the server and fill in
# your actual values. NEVER commit this file to Git.
# ─────────────────────────────────────────────────────────────

# ── Required: Your API domain (for Caddy TLS) ──
API_DOMAIN=api.thermacity.com

# ── Required: Supabase PostgreSQL connection ──
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── ML Model (mounted via Docker volume — typically no change needed) ──
ML_MODEL_PATH=/app/ml_model/rf_lst_predictor_v1.joblib

# ── HVI Weights ──
HVI_WEIGHTS={"lst": 0.35, "humidity": 0.15, "wind": 0.10, "population": 0.20, "canopy": 0.20}

# ── Server ──
DEBUG=false
CORS_ORIGINS=https://thermacity.vercel.app,https://thermacity-admin.vercel.app,https://thermacity.com,https://admin.thermacity.com
