# ─────────────────────────────────────────────────
# ThermaCity — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────

# PostgreSQL / PostGIS
POSTGRES_DB=thermacity
POSTGRES_USER=thermacity
POSTGRES_PASSWORD=thermacity_dev_2026
DB_PORT=5432

# Async SQLAlchemy connection string
DATABASE_URL=postgresql+asyncpg://thermacity:thermacity_dev_2026@localhost:5432/thermacity

# ML Model
ML_MODEL_PATH=../ml/models/rf_lst_predictor_v1.joblib

# Heat Vulnerability Score Weights (JSON — must sum to 1.0)
# lst=surface heat, population=exposure risk, canopy=shade deficit,
# humidity=feels-like amplifier, wind=trapped heat
HVI_WEIGHTS={"lst": 0.35, "humidity": 0.15, "wind": 0.10, "population": 0.20, "canopy": 0.20}

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
